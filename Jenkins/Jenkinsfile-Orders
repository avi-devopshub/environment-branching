
pipeline {
    agent {
        label 'agent'
    }

    parameters {
        choice(
            name: 'BRANCH_NAME',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select Git Branch'
        )
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = 'YOUR_AWS_ACCOUNT_ID'
        ECR_REPO = 'orders-service'
        IMAGE_TAG = "${BRANCH_NAME}-${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH_NAME}",
                    url: 'https://github.com/avi-devopshub/environment-branching.git',
                    credentialsId: 'github-credentials'
            }
        }

        stage('Build') {
            steps {
                echo "Building Orders Service for ${params.BRANCH_NAME}"
            }
        }

        stage('Docker Build') {
            steps {
                dir('microservices/orders') {
                    sh """
                        echo "${ECR_REPO}:${IMAGE_TAG}"
                    """
                }
            }
        }
        /*
        stage('Image Push') {
